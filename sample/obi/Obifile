# ============================================================
# KIZUNA sample -- Obifile real (nao ilustrativo -- compila e linka)
# Constroi main.com combinando KAJI80 (dono do Start) e DIGNAC (modulo
# biblioteca, sem PROCEDURE Main), mais um resource embutido e a MSXLIB
# via biblioteca .hlib ja empacotada.
#
# Tudo no banco 0 de proposito (single-bank): o bootstrap multi-banco do
# MUSUBI (ALL_SEG/EXTBIO, v4.5.2) ainda nao foi confirmado em execucao
# real -- ver chart_lib.bas e a memoria do projeto para o achado.
# ============================================================

target: main.com
entry: Start
base: 0x0100

resources:
  - file: banner.txt
    bank: 0
    symbol: Res_Banner
    size: 256

modules:
  - name: Main
    source: main.asm
    compiler: kaji80
    bank: 0

  - name: ChartLib
    source: chart_lib.bas
    compiler: dignac
    bank: 0

link:
  map: main.map

libraries:
  - ../../lib/msxlib.hlib
